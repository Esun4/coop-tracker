generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth) ────────────────────────────────────────

// Billing tier. Deliberately an enum rather than a boolean: a third tier later
// is a migration, not a rewrite of every call site.
enum PlanTier {
  FREE
  PRO
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String?

  // Entitlement. `proUntil` null means perpetual (a comped or lifetime
  // account); a date means access ends then, which is what a cancelled
  // Stripe subscription sets so the user keeps what they paid for until the
  // period closes. The Stripe ids are unique so a webhook can look a user up
  // by them without scanning.
  plan                 PlanTier  @default(FREE)
  proUntil             DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique

  googleAccessToken  String?
  googleRefreshToken String?
  lastEmailSync      DateTime?

  // Which reminders are on, and how long before. Kept as JSON rather than a
  // second table: it is a per-kind settings blob, never queried across users.
  reminderSettings Json?
  digestEnabled    Boolean @default(true)
  quietHoursStart  String  @default("22:00")
  quietHoursEnd    String  @default("08:00")

  // Appearance and scanning preferences live on the account, not in
  // localStorage: they should follow you to another machine.
  theme          String  @default("system") // light | dark | system
  palette        String  @default("ledger") // ledger | ink
  density        String  @default("compact") // compact | comfortable
  // manual | every6h | daily8am — the scheduled options are Pro-only, and a
  // lapsed account reads back as "manual" rather than being rewritten here.
  scanFrequency  String  @default("manual")

  accounts        Account[]
  sessions        Session[]
  applications    Application[]
  emailSuggestions EmailSuggestion[]
  activityLogs    ActivityLog[]
  rateLimitEvents RateLimitEvent[]
  reminders       Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application Tracker ────────────────────────────────────

enum ApplicationStatus {
  APPLIED
  OA
  INTERVIEW
  FINAL_ROUND
  OFFER
  REJECTED
  WITHDRAWN
}

model Application {
  id              String            @id @default(cuid())
  userId          String
  company         String
  roleTitle       String
  location        String?
  applicationDate DateTime?
  status          ApplicationStatus @default(APPLIED)
  source          String?
  notes           String?
  contactInfo     String?
  archived        Boolean           @default(false)

  // A date the application is working towards — an assessment due, an offer to
  // decide on. `deadlineSource` records whether a human typed it or the
  // classifier read it out of an email; `deadlineNote` keeps the sentence it
  // came from, so a wrong date is traceable to its source.
  deadlineAt     DateTime?
  deadlineSource String?
  deadlineNote   String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityLogs ActivityLog[]
  reminders    Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, archived])
  @@index([userId, archived, status])
  @@index([userId, source])
}

// ─── Email Integration ──────────────────────────────────────

enum SuggestedAction {
  NEW_APPLICATION
  STATUS_UPDATE
}

model EmailSuggestion {
  id              String          @id @default(cuid())
  userId          String
  emailMessageId  String          @unique
  emailSubject    String
  emailSender     String
  emailDate       DateTime
  emailSnippet    String?
  suggestedAction SuggestedAction
  suggestedStatus ApplicationStatus?
  suggestedCompany String?
  suggestedRole    String?
  confidence      Float
  reasoning       String?
  emailThreadId   String?
  replySentAt     DateTime?
  applicationId   String?
  resolved        Boolean         @default(false)
  resolvedAction  String?
  resolvedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, resolved])
}

// ─── Activity Log ───────────────────────────────────────────

enum ActivitySource {
  manual
  csv_import
  email_suggestion
}

model ActivityLog {
  id            String         @id @default(cuid())
  userId        String
  applicationId String?
  action        String
  details       Json?
  source        ActivitySource @default(manual)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([applicationId])
}

// A pure timestamp ledger for per-user, per-feature rate limiting. Stores no
// generated content — only that a rate-limited action ran. Reused across
// features via the `feature` discriminator (e.g. "cover_letter", later
// "resume_tailor"), each getting its own independent budget.
//
// A row is keyed by EXACTLY ONE subject: a signed-in user (`userId`) or a
// caller's network address (`ipHash`). Both are nullable so the two budgets can
// share one table and one query path; the "exactly one" rule is enforced in
// `src/lib/rate-limit.ts`, not by the DB, since Prisma can't express a check
// constraint. Keeping `userId` a real FK (rather than collapsing both into a
// generic subject string) means deleting a user still cascades their events
// away instead of leaving orphans.
//
// `ipHash` is an HMAC, never a raw address — see `src/lib/client-ip.ts`.
model RateLimitEvent {
  id        String   @id @default(cuid())
  userId    String?
  ipHash    String?
  feature   String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, feature, createdAt])
  @@index([ipHash, feature, createdAt])
}

enum ReminderKind {
  ASSESSMENT_DUE
  OFFER_DECISION
  INTERVIEW_TOMORROW
  NO_REPLY
  POSTING_CLOSES
}

// A single pending nudge. Materialised when a date lands on an application —
// usually read out of an email — so a reminder exists without anyone typing
// it in. `sentAt` makes delivery idempotent; a snooze pushes it forward.
model Reminder {
  id            String       @id @default(cuid())
  userId        String
  applicationId String?
  kind          ReminderKind
  offsetMinutes Int
  viaEmail      Boolean      @default(true)
  viaPush       Boolean      @default(false)
  scheduledFor  DateTime
  sentAt        DateTime?
  snoozedUntil  DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([applicationId])
  // The sweep reads exactly this: unsent reminders whose time has come.
  @@index([sentAt, scheduledFor])
}
